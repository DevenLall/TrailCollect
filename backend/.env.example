PORT=4000

# Supabase project (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Google Cloud OAuth client with the Gmail API enabled, plus a one-time
# refresh token for the Gmail account that will send the codes.
GMAIL_CLIENT_ID=replace-with-client-id
GMAIL_CLIENT_SECRET=replace-with-client-secret
GMAIL_REFRESH_TOKEN=replace-with-refresh-token
GMAIL_SENDER_EMAIL=youraddress@gmail.com
